{
  "$comment": "Definition of the Booking MCP server: what it says in the MCP handshake, the tools it offers (with JSON Schema inputs), and the mock data it serves. All names and places are fictional.",
  "protocolVersion": "2025-06-18",
  "serverInfo": {
    "name": "booking-mcp-server",
    "title": "Booking MCP Server",
    "version": "1.0.0"
  },
  "capabilities": {
    "tools": { "listChanged": false }
  },
  "instructions": "Search listings first, then call check_availability for a quote before create_booking. Dates are ISO-8601 (YYYY-MM-DD). Money is in minor units (cents).",

  "tools": [
    {
      "name": "search_listings",
      "title": "Search listings",
      "description": "Find hotels, resorts, tours and restaurants. Every argument is optional; with none it returns everything.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": { "type": "string", "description": "Free text matched against name, city and description" },
          "category": { "type": "string", "enum": ["HOTEL", "RESORT", "TOUR", "DINING"] },
          "city": { "type": "string", "description": "Exact city name, e.g. Siem Reap" },
          "guests": { "type": "integer", "minimum": 1, "description": "Only listings that fit this many guests" }
        }
      },
      "example": { "query": "angkor", "category": "TOUR" }
    },
    {
      "name": "get_listing",
      "title": "Get listing",
      "description": "Full details of one listing.",
      "inputSchema": {
        "type": "object",
        "properties": { "listingId": { "type": "string" } },
        "required": ["listingId"]
      },
      "example": { "listingId": "lst-angkor-lodge" }
    },
    {
      "name": "check_availability",
      "title": "Check availability",
      "description": "Checks the dates and guest count and returns a price quote. Tours and dining are priced per person and always use 1 night.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "listingId": { "type": "string" },
          "checkIn": { "type": "string", "format": "date" },
          "nights": { "type": "integer", "minimum": 1, "maximum": 30 },
          "guests": { "type": "integer", "minimum": 1 }
        },
        "required": ["listingId", "checkIn", "nights", "guests"]
      },
      "example": { "listingId": "lst-angkor-lodge", "checkIn": "2026-12-20", "nights": 2, "guests": 2 }
    },
    {
      "name": "create_booking",
      "title": "Create booking",
      "description": "Books a listing. Fails with NOT_AVAILABLE when the dates are taken.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "listingId": { "type": "string" },
          "checkIn": { "type": "string", "format": "date" },
          "nights": { "type": "integer", "minimum": 1, "maximum": 30 },
          "guests": { "type": "integer", "minimum": 1 },
          "guestName": { "type": "string", "minLength": 1 },
          "note": { "type": "string" }
        },
        "required": ["listingId", "checkIn", "nights", "guests", "guestName"]
      },
      "example": { "listingId": "lst-tonle-sap", "checkIn": "2026-12-05", "nights": 1, "guests": 2, "guestName": "Sok Dara" }
    },
    {
      "name": "list_bookings",
      "title": "List bookings",
      "description": "The user's bookings, newest stay first.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["CONFIRMED", "COMPLETED", "CANCELLED"] }
        }
      },
      "example": { "status": "CONFIRMED" }
    },
    {
      "name": "get_booking",
      "title": "Get booking",
      "description": "One booking with its listing.",
      "inputSchema": {
        "type": "object",
        "properties": { "bookingId": { "type": "string" } },
        "required": ["bookingId"]
      },
      "example": { "bookingId": "bk-1001" }
    },
    {
      "name": "cancel_booking",
      "title": "Cancel booking",
      "description": "Cancels an upcoming confirmed booking. Free-cancellation listings are refunded in full; non-refundable ones are not.",
      "inputSchema": {
        "type": "object",
        "properties": { "bookingId": { "type": "string" } },
        "required": ["bookingId"]
      },
      "example": { "bookingId": "bk-1002" }
    }
  ],

